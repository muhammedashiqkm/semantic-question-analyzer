# .env.example
#
# Values are written WITHOUT quotes. Some runtimes hand an env file straight to
# the container, and a quoted value then arrives with its quotes inside it - a
# key that looks right in the file and is refused by every provider.

FLASK_APP=run.py
FLASK_ENV=production

# Where this service listens. One value: the app binds it, the container
# publishes it, and the health check asks it.
PORT=5009

# 127.0.0.1 keeps a development run off the network. The container overrides
# this to 0.0.0.0, which it must.
HOST=127.0.0.1

# Who may call this service.
#
# One fixed key, sent as X-API-Key, held by the portal and never by a browser.
# Empty accepts every caller, which suits only a machine nothing else can
# reach. Generate one with:
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | cut -c1-32
API_KEY=

# Model providers. A provider with no key is unavailable; /health lists the
# ones that are usable.
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Which model each provider uses, per role. A request names the PROVIDER; the
# model it maps to is set here.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_REASONING_MODEL=gemini-2.5-flash
OPENAI_REASONING_MODEL=gpt-4o
DEEPSEEK_REASONING_MODEL=deepseek-chat

# How close two questions must be before a model is asked to judge them.
# Lower finds more candidates and costs more; higher misses reworded duplicates.
SIMILARITY_THRESHOLD=0.75

# Only the portal calls this service, so naming it is better than leaving it open.
CORS_ORIGINS=*

COMPOSE_PROJECT_NAME=semantic-question-analyzer
